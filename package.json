{
  "name": "@shelf/datetime",
  "version": "2.7.0",
  "description": "Shelf dates library",
  "keywords": [
    "dates",
    "date",
    "time",
    "datetime",
    "dayjs",
    "day.js",
    "day"
  ],
  "license": "MIT",
  "author": {
    "name": "Shelf",
    "email": "vlad@shelf.io",
    "url": "https://shelf.io"
  },
  "sideEffects": [
    "lib/utils/importLocales.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./react": {
      "types": "./lib/react/index.d.ts",
      "default": "./lib/react/index.js"
    }
  },
  "module": "./lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "analyze-bundle": "pnpm build && size-limit --why",
    "build": "rm -rf lib/ && tsc",
    "coverage": "pnpm test --coverage",
    "find-deadcode": "knip --no-progress",
    "lint": "oxfmt && eslint . --fix",
    "lint:ci": "oxfmt --check && eslint .",
    "lint:size": "size-limit",
    "prepack": "pnpm build",
    "prepare": "husky",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "dayjs": "1.11.19"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shelf/eslint-config": "7.2.0",
    "@shelf/prettier-config": "1.1.1",
    "@shelf/tsconfig": "0.2.0",
    "@size-limit/esbuild-why": "12.0.0",
    "@size-limit/preset-small-lib": "12.0.0",
    "@swc/core": "1.15.11",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "knip": "6.38.0",
    "lint-staged": "16.2.7",
    "oxfmt": "0.64.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "size-limit": "12.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "path": "lib/index.js",
      "limit": "11.04 KB"
    },
    {
      "path": "lib/index.js",
      "import": "{addMonths}",
      "limit": "3.33 KB"
    },
    {
      "path": "lib/react/index.js",
      "import": "{FormatTime}",
      "limit": "5 KB"
    }
  ],
  "lint-staged": {
    "*.{html,md,yml}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts,json}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@12.6.0"
}
